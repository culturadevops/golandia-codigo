FROM denoland/deno:2.9.8
WORKDIR /app
COPY logica.ts servidor.ts paralelo.ts /app/
RUN deno check servidor.ts paralelo.ts
EXPOSE 8080
ENV MODO=run
ENTRYPOINT ["sh", "-c", "if [ \"$MODO\" = paralelo ]; then exec deno serve --parallel --host 0.0.0.0 --port 8080 --allow-net=0.0.0.0:8080 paralelo.ts; else exec deno run --allow-net=0.0.0.0:8080 servidor.ts; fi"]
