# Igual que Dockerfile.scala-native, pero con Commix (el recolector paralelo de Scala Native) en vez de Immix.
FROM virtuslab/scala-cli:1.18.0 AS build
WORKDIR /src
COPY src/Servidor.scala /src/
RUN scala-cli --power package --server=false --scala 3.10.0 --native --native-version 0.5.12 --native-mode release-full --native-gc commix Servidor.scala -o /servidor
FROM debian:trixie-slim
COPY --from=build /servidor /servidor
EXPOSE 8080
ENTRYPOINT ["/servidor"]
