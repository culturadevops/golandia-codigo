# Imagen para compilar Kotlin: el JDK oficial (Temurin 21) + el compilador oficial de JetBrains, versión fija.
FROM eclipse-temurin:21-jdk
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/* \
 && curl -sSL https://github.com/JetBrains/kotlin/releases/download/v2.4.21/kotlin-compiler-2.4.21.zip -o /tmp/k.zip \
 && unzip -q /tmp/k.zip -d /opt && rm /tmp/k.zip
ENV PATH="/opt/kotlinc/bin:${PATH}"
