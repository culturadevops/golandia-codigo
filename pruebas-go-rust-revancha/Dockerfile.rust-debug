# golandia 958 · ¿Go o Rust? La revancha · SIN --release (modo debug, lo que da cargo build / cargo run a secas), glibc
FROM rust:1.99.1-trixie AS build
WORKDIR /build
COPY axum/Cargo.toml axum/Cargo.lock /build/
COPY axum/src /build/src
RUN cargo build --locked && cp target/debug/servidor /servidor
FROM debian:trixie-slim
COPY --from=build /servidor /servidor
EXPOSE 8080
ENTRYPOINT ["/servidor"]
